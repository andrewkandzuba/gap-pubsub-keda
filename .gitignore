# Ignore IDE specific files
.idea/
*.iml

# Ignore Terraform files
# Terraform state files
terraform.tfstate
terraform.tfstate.backup
*.tfstate.*.backup
.terraform.tfstate.lock.info

# Terraform generated directories
.terraform/

# Terraform plan files
*.tfplan
*.tfplan.json

# Terraform variable files (if they contain sensitive data)
*.tfvars
*.tfvars.json

# Terraform CLI configuration files
.terraformrc
terraform.rc

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
